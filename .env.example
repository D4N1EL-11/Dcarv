NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Dcarv"
NEXT_PUBLIC_APP_VERSION="0.1.0"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATA_DIR=./data
JWT_SECRET=change-this-secret-in-production
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Supabase public client configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key required by user administration endpoints. Never use NEXT_PUBLIC_ here.
SUPABASE_SECRET_KEY=

# Soporte de Salas: conexión directa a Postgres (lib/db/conexion.ts y scripts db:*).
# Local usa NON_POOLING (5432); Vercel usa el transaction pooler (6543).
Dcarv_POSTGRES_URL=
Dcarv_POSTGRES_URL_NON_POOLING=

# Vercel Cron: protege /api/cron/reasignar (RN-10). Genera un valor largo y aleatorio.
CRON_SECRET=
# Notificaciones push (M14). Genere el par con: npx web-push generate-vapid-keys
# La pública viaja al navegador; la privada es solo del servidor. Sin ellas, la opción no aparece.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Opcional: mailto: o URL que identifica a quien envía (por defecto, la URL de la app).
VAPID_SUBJECT=
