    "db:verificar": "node scripts/verificar-bd.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ver": "vitest",
    "db:limpiar": "node scripts/limpiar-prueba.mjs",
    "probar:flujo": "tsx --env-file=.env.local scripts/probar-flujo.ts",
    "probar:opcionales": "tsx --env-file=.env.local scripts/probar-opcionales.ts",
    "probar:mejoras": "tsx --env-file=.env.local scripts/probar-mejoras.ts",
    "db:demo": "tsx --env-file=.env.local scripts/cargar-demo.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/connect": "^2.5.2",
    "@vercel/kv": "^3.0.0",
    "bcryptjs": "^3.0.2",
    "framer-motion": "^12.23.24",
    "jose": "^6.1.0",
    "next": "^15.5.4",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.34.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.4",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vercel": "^64.5.0",
    "vitest": "^3.2.4"
  }
