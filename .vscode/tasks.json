{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Check current repository state",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short",
				"--branch"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stage safe environment template",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				".env.example"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Confirm local secrets ignored",
			"type": "shell",
			"command": "git",
			"args": [
				"check-ignore",
				".env.local"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect safe environment template diff",
			"type": "shell",
			"command": "git",
			"args": [
				"diff",
				"--cached",
				"--",
				".env.example"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}